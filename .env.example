# App
PORT=8014
NODE_ENV=development
LOG_LEVEL=debug
APP_PUBLIC_URL=http://localhost:8014

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accounting_db
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Auth
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
JWT_SECRET_OLD=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ganti_juga_dengan_secret_acak_minimal_32_karakter
JWT_REFRESH_EXPIRES_IN=7d

# Integrasi
CORS_ORIGIN=http://localhost:5173
ENABLE_SWAGGER=true

# Rate limit & pool
RATE_LIMIT_MAX=500
RATE_LIMIT_TIME_WINDOW_MS=60000
RATE_LIMIT_ALLOW_LIST=127.0.0.1
BCRYPT_SALT_ROUNDS=10

# Catatan: RABBITMQ_URL dan ENCRYPTION_KEY sengaja belum ada di sini karena
# 6 subtugas 1.2 saat ini tidak butuh queue/async atau secret at-rest.
# Tinggal tambah kalau nanti benar-benar dibutuhkan, tanpa mengubah struktur.
