{
  "name": "accounting-backend",
  "version": "0.1.0",
  "description": "Backend clone Manager.io - dibangun sesuai Backend-Boilerplate-Guide.pdf (TypeScript + Fastify 5)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrations:generate": "drizzle-kit generate",
    "migrations:run": "drizzle-kit migrate",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "dev:setup": "docker-compose up -d && pnpm run migrations:run",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.23.8",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^10.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@fastify/under-pressure": "^9.0.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0",
    "drizzle-kit": "^0.31.0",
    "@types/pg": "^8.11.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.9.0"
  }
}
